<?xml version="1.0" encoding="utf-8"?>
<!-- One denomination tile. "Activated" (set from code) = at least one of this note is needed.
     Tiles show results only, so they are deliberately flat and not styled like keys. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_100" />
            <stroke android:width="@dimen/hairline" android:color="@color/gold_500" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/hairline" android:color="@color/outline" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>
</selector>
